{
  "manifest_version": 3,
  "name": "UTM-NOW",
  "version": "1.0.0",
  "description": "Turn the current page or any link into a UTM-tagged link.",
  "permissions": [
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "UTM-NOW",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}